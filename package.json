{
  "name": "etf-is-all-you-need",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:update": "node scripts/fetch-etf-data.mjs",
    "check:data": "node scripts/check-data.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:data && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run data:update && npm run check:data && npm run test && vite build"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
