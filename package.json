{
  "name": "etf-is-all-you-need",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:update": "node scripts/fetch-etf-data.mjs",
    "check:data": "node scripts/check-data.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run data:update && npm run check:data && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "verify": "npm run data:update && npm run check:data && npm run test && vite build"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.60.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
